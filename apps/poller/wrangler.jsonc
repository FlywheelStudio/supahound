// Supahound poller (decision 008).
//   cron  -> list due project scopes (scheduler role, IDs only) -> one queue message per scope
//   queue -> one tenant-scoped poll per message (app role)
// Secrets (wrangler secret put): SUPAHOUND_MASTER_KEYS, SUPABASE_OAUTH_CLIENT_SECRET. Optional:
// AI_GATEWAY_API_KEY (without it, alerts use template text and no model is called; decision 025).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "supahound-poller",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "POLL_QUEUE", "queue": "supahound-polls" }],
    "consumers": [
      {
        "queue": "supahound-polls",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 20,
        "dead_letter_queue": "supahound-polls-dlq"
      }
    ]
  },
  // One Hyperdrive config per database role. Create BOTH with --caching-disabled: RLS results
  // depend on a transaction setting, so a query cache could serve one tenant's rows to another.
  // Point them at Supabase's direct or session connection, never the transaction pooler.
  // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP (and _SCHEDULER).
  // The IDs below are placeholders until the Hyperdrive configs exist.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_APP",
      "id": "00000000000000000000000000000001"
    },
    {
      "binding": "HYPERDRIVE_SCHEDULER",
      "id": "00000000000000000000000000000002"
    }
  ],
  "vars": {
    "SUPAHOUND_SOURCE_COLUMN": "source",
    // Same Supabase OAuth app as the web app; used to refresh connection tokens.
    "SUPABASE_OAUTH_CLIENT_ID": "REPLACE_WITH_OAUTH_CLIENT_ID",
    "APP_URL": "http://localhost:5173"
  },
  "secrets": { "required": ["SUPAHOUND_MASTER_KEYS", "SUPABASE_OAUTH_CLIENT_SECRET"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
