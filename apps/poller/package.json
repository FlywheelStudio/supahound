{
  "name": "@supahound/poller",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: cron scheduler and queue consumer that polls customer projects",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types src/worker-configuration.d.ts --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@supahound/core": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.155",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
