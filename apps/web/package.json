{
  "name": "@supahound/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@supahound/core": "workspace:*",
    "@vinext/cloudflare": "^1.3.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "standardwebhooks": "^1.1.1",
    "vinext": "^1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@playwright/test": "~1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitejs/plugin-rsc": "^0.5.39",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --strict-vars=false",
    "test": "vitest run",
    "e2e": "vite build && playwright test -c e2e/playwright.config.ts",
    "e2e:only": "playwright test -c e2e/playwright.config.ts"
  }
}
