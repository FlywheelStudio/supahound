// Guardbase web app (decisions 009, 010). Next.js App Router on Workers via vinext.
// Secrets (wrangler secret put): SEND_EMAIL_HOOK_SECRET ("v1,whsec_..." from Supabase Auth hooks),
// SUPABASE_OAUTH_CLIENT_SECRET, GUARDBASE_MASTER_KEYS (same keys as the poller).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardbase-web",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  // App role only, through withTenantForUser. Create with --caching-disabled (decision 008).
  // Local dev: CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_APP.
  "hyperdrive": [{ "binding": "HYPERDRIVE_APP", "id": "00000000000000000000000000000001" }],
  // Magic links and alerts (decision 014). The sender domain must be onboarded to Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "APP_URL": "http://localhost:5173",
    "SUPABASE_URL": "https://YOUR-PROJECT-REF.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    "EMAIL_FROM_ADDRESS": "login@guardbase.example",
    "EMAIL_FROM_NAME": "Guardbase",
    // Supabase OAuth app (decision 012). Redirect URI: <APP_URL>/api/supabase/callback.
    "SUPABASE_OAUTH_CLIENT_ID": "REPLACE_WITH_OAUTH_CLIENT_ID"
  },
  "secrets": { "required": ["SEND_EMAIL_HOOK_SECRET", "SUPABASE_OAUTH_CLIENT_SECRET", "GUARDBASE_MASTER_KEYS"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
