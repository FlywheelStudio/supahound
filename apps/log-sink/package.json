{
  "name": "@supahound/log-sink",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare tail Worker: keeps the web and poller Workers' own events in R2 for 90 days",
  "type": "module",
  "scripts": {
    "types": "wrangler types src/worker-configuration.d.ts --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@supahound/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
