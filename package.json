{
  "name": "supahound",
  "version": "0.1.0",
  "private": true,
  "description": "Supahound: abnormal-traffic monitoring for Supabase apps",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "scan": "pnpm --filter @supahound/core scan",
    "discover-keys": "pnpm --filter @supahound/core discover-keys",
    "master-key": "pnpm --silent --filter @supahound/core master-key",
    "print-sql": "pnpm --silent --filter @supahound/core print-sql",
    "e2e": "pnpm --filter @supahound/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.7",
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
