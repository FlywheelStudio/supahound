# Supabase Management API token with the analytics:read scope.
# Use a personal access token for the prototype; production uses per-tenant OAuth tokens.
SUPABASE_ACCESS_TOKEN=
# Project ref of the project to scan (the subdomain of <ref>.supabase.co).
SUPABASE_PROJECT_REF=
# Optional. Column that names the log source. The API reference says "source"; the
# 23 Sept 2026 changelog says "source_name". Task 1 settles it.
GUARDBASE_SOURCE_COLUMN=source

# --- Worker (pnpm worker) ---
# Login role that is a member of guardbase_app. Never a superuser or table owner.
DATABASE_URL=
# Login role that is a member of guardbase_scheduler (reads project IDs only).
SCHEDULER_DATABASE_URL=
# Versioned 32-byte master keys, base64: "1:<key>,2:<key>". The highest version seals.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GUARDBASE_MASTER_KEYS=
# Vercel AI Gateway key (Pro or Enterprise team, required for zero data retention).
AI_GATEWAY_API_KEY=
GUARDBASE_TICK_SECONDS=15
