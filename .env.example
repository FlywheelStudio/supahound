# Supabase Management API token with the analytics:read scope.
# Use a personal access token for the prototype; production uses per-tenant OAuth tokens.
SUPABASE_ACCESS_TOKEN=
# Project ref of the project to scan (the subdomain of <ref>.supabase.co).
SUPABASE_PROJECT_REF=
# Optional. Column that names the log source. The API reference says "source"; the
# 23 Sept 2026 changelog says "source_name". Task 1 settles it.
SUPAHOUND_SOURCE_COLUMN=source

# Workers (apps/poller, apps/web) read their settings from wrangler.jsonc vars and secrets,
# with local values in .dev.vars. See each wrangler.jsonc.

# Subprocessor notice (`pnpm subprocessor-notice`, decision 037). Operator only; never on a Worker.
# A connection string for a login in supahound_notifier (supabase/setup/notifier-user.sql).
SUPAHOUND_NOTIFIER_DATABASE_URL=
# Only with --send or --test-to: Cloudflare Email Sending REST API. The token needs permission to
# send email; the from address must be on a domain onboarded to Email Sending.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
NOTICE_FROM_ADDRESS=
NOTICE_FROM_NAME=Supahound

# Conversion of seat subscriptions to one subscription per project (`pnpm convert-subscriptions`,
# decision 041). Operator only; never on a Worker. A dry run is the default; --apply changes Stripe.
# Logins in supahound_app and supahound_scheduler (supabase/setup/login-users.sql).
SUPAHOUND_APP_DATABASE_URL=
SUPAHOUND_SCHEDULER_DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Optional. Defaults to https://api.stripe.com.
STRIPE_API_URL=
# The same list as the web Worker: a staff workspace whose exemption is not granted yet is skipped.
SUPAHOUND_BILLING_EXEMPT_DOMAINS=
